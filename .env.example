# Servidores DNS separados por comas (vacio = los del sistema)
DNS_NAMESERVERS=1.1.1.1,8.8.8.8
# Tiempo maximo por consulta DNS en segundos
DNS_TIMEOUT=3
# Ruta de la base de datos SQLite
DATABASE_PATH=data/dnsinspector.db
# Peticiones maximas por minuto y por IP en endpoints que hacen consultas
RATE_LIMIT_PER_MINUTE=30
# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
